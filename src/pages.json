{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/busAssistant/index",
			"style": {
				"navigationBarTitleText": "公交助手",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/routeDetail/index",
			"style": {
				"navigationBarTitleText": "线路详情",
				"navigationStyle": "default"
			}
		},
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "我的"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "公交助手",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"tabBar": {
		"color": "#7A7E83",
		"selectedColor": "#4a89dc",
		"borderStyle": "black",
		"backgroundColor": "#ffffff",
		"list": [
			{
				"pagePath": "pages/busAssistant/index",
				"iconPath": "static/images/home.png",
				"selectedIconPath": "static/images/home.png",
				"text": "公交线路"
			},
			{
				"pagePath": "pages/index/index",
				"iconPath": "static/images/bus.png",
				"selectedIconPath": "static/images/bus.png",
				"text": "我的"
			}
		]
	},
	"uniIdRouter": {}
}
